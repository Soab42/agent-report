#!/usr/bin/env bash
# ai-report — generate the AI Tools usage dashboard from anywhere.
#
#   ai-report                 # build report in the current directory and open it
#   ai-report -o ~/foo.html   # custom output path
#   ai-report --no-open       # build but don't open in a browser
#   ai-report --today         # any flag the analyzer accepts is passed through
#   ai-report --help          # show the analyzer's own options
#
# Extra flags are forwarded verbatim to claude_analyzer.py.
set -euo pipefail

SCRIPT="/home/soab/working/personal/ailense/claude_analyzer.py"

if [[ ! -f "$SCRIPT" ]]; then
  echo "ai-report: analyzer not found at $SCRIPT" >&2
  echo "  (edit the SCRIPT path in $(command -v ai-report) if you moved the repo)" >&2
  exit 1
fi

open=1
out=""
args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-open)      open=0; shift ;;
    -o|--output)    out="${2:-}"; args+=("$1" "${2:-}"); shift 2 ;;
    -o=*|--output=*) out="${1#*=}"; args+=("$1"); shift ;;
    *)              args+=("$1"); shift ;;
  esac
done

# Default output: ai-report.html in the current directory.
if [[ -z "$out" ]]; then
  out="$PWD/ai-report.html"
  args+=(-o "$out")
fi

python3 "$SCRIPT" "${args[@]}"

if [[ "$open" -eq 1 ]] && command -v xdg-open >/dev/null 2>&1; then
  xdg-open "$out" >/dev/null 2>&1 || true
fi
