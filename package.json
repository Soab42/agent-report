{
  "name": "ailense",
  "version": "0.1.5",
  "description": "Unified dashboard for AI conversation logs (Claude, Gemini, Codex, Puku, OpenCode, ChatGPT, Antigravity) + built-in MyAgent server",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "ailense": "src/index.js"
  },
  "files": [
    "src",
    "public",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "snapshot": "node src/index.js --snapshot"
  },
  "engines": {
    "node": ">=22.5"
  },
  "keywords": [
    "ai",
    "claude",
    "gemini",
    "codex",
    "chatgpt",
    "antigravity",
    "puku",
    "opencode",
    "analyzer",
    "dashboard",
    "agent",
    "anthropic"
  ],
  "author": "soab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Soab42/agent-report.git"
  },
  "bugs": {
    "url": "https://github.com/Soab42/agent-report/issues"
  },
  "homepage": "https://github.com/Soab42/agent-report#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "chokidar": "^3.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
